arameters\":{\"additionalProperties\":false,\"properties\":{\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\"],\"type\":\"object\"}},{\"action\":\"read_lines\",\"description\":\"Read an exact inclusive line range from one current candidate file. If the requested content exceeds 12,000 bytes, returns the largest exact line prefix that fits plus a version-bound continuation_cursor; it does not automatically fetch the next page. A single line larger than the limit is rejected explicitly.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"end_line\":{\"minimum\":1,\"type\":\"integer\"},\"path\":{\"minLength\":1,\"type\":\"string\"},\"start_line\":{\"minimum\":1,\"type\":\"integer\"}},\"required\":[\"path\",\"start_line\",\"end_line\"],\"type\":\"object\"}},{\"action\":\"read_region\",\"description\":\"Read one exact mechanically defined target region by the stable ID exposed in the initial outline. The operation is available only while the target still matches the outline's file hash. It supplies exact bytes, not a summary or relevance judgment.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"region_id\":{\"pattern\":\"^R[0-9]{3}$\",\"type\":\"string\"}},\"required\":[\"region_id\"],\"type\":\"object\"}},{\"action\":\"patch\",\"description\":\"Replace one exact UTF-8 string in one candidate file. The old text must occur exactly once and expected_file_sha256 must equal the hash returned by a current read.\",\"parameters\":{\"additionalProperties\":false,\"properties\":{\"expected_file_sha256\":{\"pattern\":\"^[0-9a-f]{64}$\",\"type\":\"string\"},\"new\":{\"type\":\"string\"},\"old\":{\"minLength\":1,\"type\":\"string\"},\"path\":{\"minLength\":1,\"type\":\"string\"}},\"required\":[\"path\",\"old\",\"new\",\"expected_file_sha256\"],\"type\":\"object\"}},{\"action\":\"replace_file\",\"description\":\"Replace one complete UTF-8 candidate file. expected_file_sha256 must equal the hash returned by a current read. new_con